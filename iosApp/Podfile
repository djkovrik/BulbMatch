source 'https://cdn.cocoapods.org/'

platform :ios, '16.2'

target 'iosApp' do
  use_frameworks! :linkage => :static

  # YandexMobileAds is static. Build and archive the generated .xcworkspace.
  # CMP 8.2.0 is documented but is not currently published to Maven Central.
  # Keep native and KMP SDKs aligned on the latest pair the resolvers can obtain.
  pod 'YandexMobileAds', '8.1.0'
  # Bundled Latin OCR; no first-run model download.
  pod 'GoogleMLKit/TextRecognition', '8.0.0'
  # Analytics is intentionally not included.
  # 12.12.0+ requires Xcode 26.2. Keep the latest release compatible with
  # this project's currently available Xcode 26.1.1 toolchain.
  pod 'FirebaseCrashlytics', '12.11.0'
end
